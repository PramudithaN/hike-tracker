{
  "expo": {
    "name": "TrailMark",
    "slug": "hike-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a2e1a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.hiketracker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TrailMark needs your location to track your hike route.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TrailMark records your GPS route in the background so your track is saved even when the screen is off.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a2e1a"
      },
      "package": "com.yourname.hiketracker",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TrailMark records your GPS route in the background so your track is saved even when the screen is off."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "hike-tracker"
  }
}
